# MySQL connection string (Hostinger MySQL in production, local Docker MySQL in dev).
DATABASE_URL=mysql://user:password@localhost:3306/deploy_your_career

# Better Auth. Secret: at least 32 characters (openssl rand -base64 32). URL: public origin of the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional; set both or neither). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owners (comma-separated emails, optional). Owners can always sign in and manage who has access.
# Everyone else must be added to the allowlist (admin page) before they can sign in.
OWNER_EMAILS=
